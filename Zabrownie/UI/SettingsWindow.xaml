<Window x:Class="Zabrownie.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1A1A1D"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#25252A"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#2D2D35"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3A3A45"/>

        <!-- ScrollBar and Viewers -->
        <Style x:Key="OperaGXScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Width="6"
                                                        Margin="1"
                                                        Background="{DynamicResource AccentColor}"
                                                        CornerRadius="3"
                                                        Opacity="0.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <!-- Agregado el x:Name="PART_VerticalScrollBar" para solucionar el bug de drag -->
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource OperaGXScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Elements -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}" 
                                       FontWeight="Medium" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource AccentColor}" 
                                       Margin="0,0,0,12"/>
                            <Border Background="{StaticResource BgSecondary}" 
                                    CornerRadius="12" 
                                    Padding="16">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BgTertiary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Ventana Principal -->
    <Border Background="{StaticResource BgPrimary}" CornerRadius="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="25" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}" CornerRadius="16,0,0,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,24,24">
                        <TextBlock Text="Zabrownie" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Text="Ajustes" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0">
                        <RadioButton x:Name="TabAppearance" Content="🎨 Apariencia" Style="{StaticResource TabButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabPrivacy" Content="🔒 Privacidad &amp; Seguridad" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabGeneral" Content="⚡ General" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAdvanced" Content="📊 Filtros Avanzados" Style="{StaticResource TabButtonStyle}" Checked="Tab_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="32,32,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- VISTAS -->
                <ScrollViewer Grid.Row="0">
                    <Grid>
                        <!-- APARIENCIA -->
                        <StackPanel x:Name="ViewAppearance" Visibility="Visible">
                            <TextBlock Text="Apariencia" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
                            
                            <GroupBox Header="Color de Acento">
                                <StackPanel>
                                    <TextBlock Text="Temas predefinidos:" Margin="0,0,0,12" Foreground="{StaticResource TextSecondary}"/>
                                    <UniformGrid Columns="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <Button Content="" Width="50" Height="50"
                                                Background="#8B5CF6" BorderThickness="0"
                                                Click="PresetColor_Click" Tag="#8B5CF6"
                                                Margin="0,0,12,0" ToolTip="Morado" Cursor="Hand">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="25"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Content="" Width="50" Height="50"
                                                Background="#FF006B" BorderThickness="0"
                                                Click="PresetColor_Click" Tag="#FF006B"
                                                Margin="0,0,12,0" ToolTip="Rosa" Cursor="Hand">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="25"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Content="" Width="50" Height="50"
                                                Background="#00D9FF" BorderThickness="0"
                                                Click="PresetColor_Click" Tag="#00D9FF"
                                                Margin="0,0,12,0" ToolTip="Cyan" Cursor="Hand">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="25"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Content="" Width="50" Height="50"
                                                Background="#00FF88" BorderThickness="0"
                                                Click="PresetColor_Click" Tag="#00FF88"
                                                ToolTip="Verde" Cursor="Hand">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="25"/></ControlTemplate></Button.Template>
                                        </Button>
                                    </UniformGrid>

                                    <TextBlock Text="Color personalizado (Hexadecimal):" Margin="0,8,0,8" Foreground="{StaticResource TextSecondary}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomColorTextBox" Grid.Column="0" Text="#8B5CF6" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Content="Aplicar Color" Style="{StaticResource AccentButton}" Click="ApplyCustomColor_Click"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- PRIVACIDAD Y SEGURIDAD -->
                        <StackPanel x:Name="ViewPrivacy" Visibility="Collapsed">
                            <TextBlock Text="Privacidad &amp; Seguridad" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
                            
                            <GroupBox Header="Bloqueo y Rastreo">
                                <StackPanel>
                                    <CheckBox x:Name="EnableAdBlockingCheckBox" Content="Bloquear anuncios clasificados (EasyList)"/>
                                    <CheckBox x:Name="EnableTrackerBlockingCheckBox" Content="Bloquear rastreadores web (EasyPrivacy)"/>
                                    <CheckBox x:Name="StripTrackingParamsCheckBox" Content="Eliminar parámetros de rastreo ocultos (utm_*, gclid, etc.)"/>
                                    <CheckBox x:Name="BlockThirdPartyCookiesCheckBox" Content="Bloquear cookies de sitios de terceros"/>
                                    <CheckBox x:Name="SendDoNotTrackCheckBox" Content="Enviar protocolo estándar 'Do Not Track' (DNT)"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Seguridad Extra">
                                <StackPanel>
                                    <CheckBox x:Name="DisablePasswordSavingCheckBox" Content="Deshabilitar guardado de contraseñas de Windows"/>
                                    <CheckBox x:Name="DisableAutofillCheckBox" Content="Deshabilitar autocompletado de formularios invasivos"/>
                                    <CheckBox x:Name="BlockWebRTCCheckBox" Content="Prevenir fugas de IP real bloqueando WebRTC"/>
                                    <CheckBox x:Name="ClearDataOnCloseCheckBox" Content="Limpiar todos los datos temporales al salir"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Cabecera HTTP Referrer">
                                <StackPanel>
                                    <TextBlock Text="Política de envío del sitio origen (Referrer):" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="ReferrerPolicyComboBox" SelectedIndex="1">
                                        <ComboBoxItem Content="No Referrer (máxima privacidad)" Tag="no-referrer"/>
                                        <ComboBoxItem Content="No Referrer When Downgrade (recomendado)" Tag="no-referrer-when-downgrade"/>
                                        <ComboBoxItem Content="Origin Only" Tag="origin"/>
                                        <ComboBoxItem Content="Same Origin Only" Tag="same-origin"/>
                                        <ComboBoxItem Content="Strict Origin" Tag="strict-origin"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- GENERAL -->
                        <StackPanel x:Name="ViewGeneral" Visibility="Collapsed">
                            <TextBlock Text="General" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
                            
                            <GroupBox Header="Página Principal / Home">
                                <StackPanel>
                                    <TextBlock Text="Dirección al abrir nueva pestaña vacía o presionar Home:" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="HomepageTextBox" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Permisos Globales">
                                <StackPanel>
                                    <CheckBox x:Name="EnableJavaScriptCheckBox" Content="Habilitar JavaScript (Global)"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="User Agent (Avanzado)">
                                <StackPanel>
                                    <TextBlock Text="Reescribir con qué identificador se presenta tu navegador (en blanco para usar el nativo):" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    <TextBox x:Name="UserAgentTextBox" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- FILTROS AVANZADOS -->
                        <StackPanel x:Name="ViewAdvanced" Visibility="Collapsed">
                            <TextBlock Text="Filtros Avanzados" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>
                            
                            <GroupBox Header="Estadísticas de Motor de Filtros">
                                <StackPanel>
                                    <TextBlock x:Name="FilterStatsText" FontSize="15" Margin="0,0,0,12"/>
                                    <Border Background="{DynamicResource AccentColor}" CornerRadius="8" Padding="16" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <TextBlock x:Name="BlockedCountText" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <Button Content="Limpiar Caché de Decisiones" Width="250" HorizontalAlignment="Left" Click="ClearCacheButton_Click" Style="{StaticResource AccentButton}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Excepciones (Lista Blanca)">
                                <StackPanel>
                                    <TextBlock Text="Los dominios aquí listados nunca serán bloqueados:" Margin="0,0,0,12" Foreground="{StaticResource TextSecondary}"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WhitelistDomainTextBox" Grid.Column="0" Margin="0,0,12,0"/>
                                        <Button x:Name="AddWhitelistButton" Grid.Column="1" Content="Agregar Excepción" Style="{StaticResource AccentButton}" Click="AddWhitelistButton_Click"/>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="140" Margin="0,0,0,12">
                                        <ListBox x:Name="WhitelistListBox"/>
                                    </Border>
                                    <Button x:Name="RemoveWhitelistButton" Content="Eliminar Dominio Seleccionado" Width="250" HorizontalAlignment="Left" Click="RemoveWhitelistButton_Click" Style="{StaticResource AccentButton}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Actions -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Width="120"
                                Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                BorderThickness="1" BorderBrush="{StaticResource BorderColor}"
                                Margin="0,0,12,0" Click="CancelButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Padding" Value="16,10"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource BgTertiary}"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Guardar Ajustes" Width="160" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>